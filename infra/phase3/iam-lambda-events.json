{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteEventsObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::for-promotional-use-only-events",
        "arn:aws:s3:::for-promotional-use-only-events/*"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:740625777523:log-group:/aws/lambda/promo-events-*"
    }
  ]
}
