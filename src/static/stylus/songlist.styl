@require './global.styl'

.body-content
  position relative
  font-family songTitleFont
  .total-songs
    color lighten(black,50)
    position: absolute;
    top 0
    right 3em

ul.songlist
  font-family songTitleFont
  list-style-type: none
  text-align center
  font-size: 1.2em
  li.single-song-wrapper
    padding 10px 2px
    color darken(alphabetLetter,10)
    &:hover
      //background-color: rgba(255,255,255,0.2)
      cursor: pointer;
      color alphabetLetter
      padding-bottom 9px
      padding-top 9px
      border-bottom: 1px solid primaryAccentBlue
      border-top: 1px solid primaryAccentBlue
    .title
      position relative
      display inline-flex
      align-items center
      gap 0.4em
    .song-play-control
      display inline-flex
      align-items center
      justify-content center
      margin 0
      padding 0.15em 0.35em
      border 0
      background transparent
      color inherit
      cursor pointer
      line-height 1
      &:hover .song-play-indicator
        color lighten(primaryAccentBlue, 20)
      &:focus
        outline 1px solid primaryAccentBlue
        outline-offset 2px
    .song-play-indicator
      font-size 0.7em
      color primaryAccentBlue
    &.expanded
      background-color: rgba(255,255,255,0.18)
    &.active
      background-color: rgba(255,255,255,0.3)
